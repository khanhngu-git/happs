# Copy to .env.local and fill in. Never commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Same-origin auth: production on Firebase Hosting does this automatically.
# In dev against the real project, set true (Vite proxies /__/auth) and add
# http://localhost:5173/__/auth/handler to the OAuth client's redirect URIs.
VITE_AUTH_SAME_ORIGIN=

# Dev only: talk to the local Emulator Suite (project id demo-happs)
VITE_USE_EMULATORS=true
# Set false to sign in with real Google (real Firebase Auth) while data stays in
# the emulators. Run `npm run emulators:real-auth` instead of `npm run emulators`.
VITE_AUTH_EMULATOR=

# Google Maps Platform (Maps JavaScript API + Places API (New))
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Optional: App Check (reCAPTCHA Enterprise site key)
VITE_APPCHECK_SITE_KEY=
