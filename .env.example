# Copy to .env.local and fill in. Never commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions region (must match functions/src/config.ts)
VITE_FUNCTIONS_REGION=australia-southeast1

# Dev only: talk to the local Emulator Suite (project id demo-happs)
VITE_USE_EMULATORS=true

# Google Maps Platform (Maps JavaScript API + Places API (New))
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Firebase Cloud Messaging web push certificate (VAPID) key
VITE_FCM_VAPID_KEY=
