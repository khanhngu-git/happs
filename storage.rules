rules_version = '2';

// Photos only. Download URLs carry their own token, so <img> tags work for
// anyone who was given the URL (members, invite previews); these rules
// govern the SDK reads and all writes.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function trip(tripId) {
      return firestore.get(/databases/(default)/documents/trips/$(tripId)).data;
    }

    // users/{uid}/avatar-*.jpg : only the user writes their own picture.
    match /users/{uid}/{file} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && isImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Tickets and booking confirmations: PDFs or photos, up to 10 MB.
    function isDocument() {
      return request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp|heic|heif)')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // trips/{tripId}/items/{file} : activity photos and documents; any member adds or changes them.
    match /trips/{tripId}/items/{file} {
      allow read: if signedIn() && request.auth.uid in trip(tripId).memberIds;
      allow create, update: if signedIn() && request.auth.uid in trip(tripId).memberIds
        && (file.matches('.*-doc-.*') ? isDocument() : isImage());
      allow delete: if signedIn() && request.auth.uid in trip(tripId).memberIds;
    }

    // trips/{tripId}/cover-*.jpg : members read, the owner changes the cover.
    match /trips/{tripId}/{file} {
      allow read: if signedIn() && request.auth.uid in trip(tripId).memberIds;
      allow create, update: if signedIn() && trip(tripId).ownerId == request.auth.uid && isImage();
      allow delete: if signedIn() && trip(tripId).ownerId == request.auth.uid;
    }
  }
}
